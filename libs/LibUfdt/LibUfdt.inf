#/** @file LibUfdt.inf
#
#
#**/

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = LibUfdt
  FILE_GUID                      = 6b2478c0-be23-11e0-a28c-0002a5d5c51b
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = LibUfdt

  DEFINE LIBUFDT_LIB_PATH        = libufdt
  DEFINE LIBUFDT_INC_PATH        = libufdt/include
  DEFINE LIBUFDT_SYSDEPS_PATH    = libufdt/sysdeps

#
#  VALID_ARCHITECTURES           = AARCH64
#

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -I$(WORKSPACE)/edk2/MdePkg/Library/BaseFdtLib -I$(WORKSPACE)/edk2/MdePkg/Library/BaseFdtLib/libfdt/libfdt -nostdinc -Wno-macro-redefined -DDTO_DISABLE_DEFAULT_VENDOR_LIBC_ALLOCATION -DDTO_DISABLE_DEFAULT_VENDOR_LIBC_PRINT
  CLANGDWARF:*_*_*_CC_FLAGS = -I$(WORKSPACE)/edk2/MdePkg/Library/BaseFdtLib -I$(WORKSPACE)/edk2/MdePkg/Library/BaseFdtLib/libfdt/libfdt -nostdinc -Wno-macro-redefined -DDTO_DISABLE_DEFAULT_VENDOR_LIBC_ALLOCATION -DDTO_DISABLE_DEFAULT_VENDOR_LIBC_PRINT

[Sources]
  $(LIBUFDT_LIB_PATH)/ufdt_convert.c
  $(LIBUFDT_LIB_PATH)/ufdt_node.c
  $(LIBUFDT_LIB_PATH)/ufdt_node_pool.c
  $(LIBUFDT_LIB_PATH)/ufdt_prop_dict.c
  $(LIBUFDT_LIB_PATH)/ufdt_overlay.c
  $(LIBUFDT_SYSDEPS_PATH)/libufdt_sysdeps_vendor.c
  libufdt_sysdeps_uefi.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  QualcommCommonSiliconPkg/QualcommCommonSiliconPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  ExternalPkg/Library/DTFrameWork/DTFramework/libs/LibUfdt/LibUfdt.dec
  ExternalPkg/Library/DTFrameWork/DTFramework.dec

[LibraryClasses]
  MemoryAllocationLib
  FdtLib
  BaseLib
  DebugLib

[FixedPcd]
  gQcomTokenSpaceGuid.PcdLibUfdtBufBase
  gQcomTokenSpaceGuid.PcdLibUfdtBufSize

[Pcd.common]
  gEfiMdePkgTokenSpaceGuid.PcdDebugPrintErrorLevel
